# ============================================================
# EVA-SHELL — i3 config
# Phase 3: Layout Skeleton
# ============================================================

set $mod Mod4

# ============================================================
# FONTS
# ============================================================
font pango:JetBrains Mono 10

# ============================================================
# COLORS — loaded from apply-theme.sh output
# ============================================================
include ~/.config/eva-shell/config/i3/colors.conf

# ============================================================
# VISUAL — strip all decorations
# ============================================================
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders both
gaps inner 0
gaps outer 0

# ============================================================
# LAYOUT ENGINE CORE
# ============================================================

# Left flank — sticky, 280px wide
# Assigned containers: system logs + process tree
set $left_width 280

# Right flank — sticky, 280px wide
# Assigned containers: ascii loop + MAGI
set $right_width 280

# Bottom flank — sticky, 180px tall
# Assigned containers: ranger + keyboard sensor + controls
set $bottom_height 180

# ============================================================
# STARTUP — autostart on session begin
# ============================================================

# Compositor
exec_always --no-startup-id picom --config ~/.config/eva-shell/config/picom/picom.conf -b

# Boot sequence (runs ONCE on first login, not on i3 reload)
exec --no-startup-id ~/.config/eva-shell/scripts/boot-sequence.sh

# Polybar
exec_always --no-startup-id ~/.config/eva-shell/scripts/launch-polybar.sh

# Set wallpaper (pure black)
exec_always --no-startup-id feh --bg-fill ~/.config/eva-shell/themes/eva-01/assets/wallpaper.png 2>/dev/null \
    || xsetroot -solid "#050508"

# Left flank — system logs
exec --no-startup-id kitty --class eva-left-logs \
    --title "SYS_LOG_STREAM" \
    -e ~/.config/eva-shell/scripts/log-stream.sh

# Left flank — process tree
exec --no-startup-id kitty --class eva-left-procs \
    --title "PROCESS_TREE" \
    -e btop

# Right flank — ASCII loop
exec --no-startup-id kitty --class eva-right-ascii \
    --title "ASCII_LOOP" \
    -e ~/.config/eva-shell/scripts/ascii-loop.sh

# Bottom flank — ranger
exec --no-startup-id kitty --class eva-bottom-ranger \
    --title "HOME_DIRECTORY" \
    -e ranger

# Bottom flank — keyboard sensor
exec --no-startup-id kitty --class eva-bottom-kbd \
    --title "KEYBOARD_SENSOR" \
    -e ~/.config/eva-shell/scripts/kbd-sensor.sh

# eww MAGI widget
exec --no-startup-id ~/.config/eva-shell/scripts/launch-eww.sh

# Central canvas — default terminal
exec --no-startup-id kitty --class eva-center \
    --title "CENTRAL_TERM"

# ============================================================
# WINDOW ASSIGNMENTS
# Sticky panel windows are assigned to scratchpad-like behavior
# using marks + sticky flags
# ============================================================

# Left flank containers
for_window [class="eva-left-logs"]  sticky enable
for_window [class="eva-left-logs"]  floating enable
for_window [class="eva-left-logs"]  resize set $left_width 880
for_window [class="eva-left-logs"]  move position 0 24
for_window [class="eva-left-logs"]  border pixel 1

for_window [class="eva-left-procs"] sticky enable
for_window [class="eva-left-procs"] floating enable
for_window [class="eva-left-procs"] resize set $left_width 300
for_window [class="eva-left-procs"] move position 0 904
for_window [class="eva-left-procs"] border pixel 1

# Right flank containers
for_window [class="eva-right-ascii"] sticky enable
for_window [class="eva-right-ascii"] floating enable
for_window [class="eva-right-ascii"] resize set $right_width 540
for_window [class="eva-right-ascii"] move position 1640 24
for_window [class="eva-right-ascii"] border pixel 1

# eww MAGI panel (right bottom)
# eww handles its own positioning via eww.yuck geometry

# Bottom flank — ranger
for_window [class="eva-bottom-ranger"] sticky enable
for_window [class="eva-bottom-ranger"] floating enable
for_window [class="eva-bottom-ranger"] resize set 560 $bottom_height
for_window [class="eva-bottom-ranger"] move position 0 900
for_window [class="eva-bottom-ranger"] border pixel 1

# Bottom flank — keyboard sensor
for_window [class="eva-bottom-kbd"] sticky enable
for_window [class="eva-bottom-kbd"] floating enable
for_window [class="eva-bottom-kbd"] resize set 400 $bottom_height
for_window [class="eva-bottom-kbd"] move position 560 900
for_window [class="eva-bottom-kbd"] border pixel 1

# All HUD windows stay on every workspace
for_window [class="eva-left-logs"]    move to workspace current
for_window [class="eva-left-procs"]   move to workspace current
for_window [class="eva-right-ascii"]  move to workspace current
for_window [class="eva-bottom-ranger"] move to workspace current
for_window [class="eva-bottom-kbd"]   move to workspace current

# Central canvas — all unlisted apps go here (tiling, not floating)
for_window [class="eva-center"] floating disable

# ============================================================
# WORKSPACES
# ============================================================
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

# ============================================================
# HOTKEYS
# ============================================================

# Terminal
bindsym $mod+Return exec kitty --class eva-center

# App launcher
bindsym $mod+d exec rofi -show drun -theme ~/.config/rofi/config.rasi

# Close window
bindsym $mod+Shift+q kill

# Exit i3
bindsym $mod+Shift+e exec i3-nagbar \
    -t warning \
    -m 'MAGI SYSTEM: EXIT CONFIRMATION REQUIRED' \
    -B 'CONFIRM SHUTDOWN' 'i3-msg exit'

# Reload i3 config
bindsym $mod+Shift+r reload

# Split direction
bindsym $mod+h split h
bindsym $mod+v split v

# Fullscreen (central canvas only)
bindsym $mod+f fullscreen toggle

# Resize mode
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym Left  resize shrink width  10 px or 10 ppt
    bindsym Down  resize grow   height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow   width  10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

# Focus movement
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# Move window
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# Layout toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Volume
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# Brightness
bindsym XF86MonBrightnessUp   exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

# Screenshot
bindsym Print exec import -window root ~/Pictures/eva-screenshot-$(date +%s).png
