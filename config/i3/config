# ============================================================
# EVA-SHELL — i3 config
# Layout: gaps-based HUD with clean center workspace
# eww handles all HUD panels (left, right, center-top, bottom)
# No floating terminals in HUD areas — zero overlap
# ============================================================

set $mod Mod4

# ============================================================
# FONTS
# ============================================================
font pango:JetBrains Mono 10

# ============================================================
# COLORS — loaded from apply-theme.sh output
# ============================================================
include ~/.config/eva-shell/config/i3/colors.conf

# ============================================================
# VISUAL — strip all decorations
# ============================================================
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders both

# ============================================================
# GAPS — Reserve screen edges for eww HUD panels
# This ensures tiled windows NEVER overlap the HUD
# ============================================================
# Layout (1920x1080):
#   Polybar top:     24px   (override-redirect, not managed by i3)
#   Left flank:      280px  (eww panel)
#   Right flank:     280px  (eww panel)
#   Bottom strip:    120px  (eww panel)
#
# Center workspace: MAGI TUI (top tile) + terminal (bottom tile)
# managed by i3 tiling — no eww overlay in center
# Tiling area: (280, 24) -> (1640, 960) = 1360x936px

gaps inner 0
gaps outer 0
gaps left 280
gaps right 280
gaps bottom 120
gaps top 24

# ============================================================
# STARTUP — autostart on session begin
# ============================================================

# Compositor
exec_always --no-startup-id picom --config ~/.config/eva-shell/config/picom/picom.conf -b

# Boot sequence (runs ONCE on first login, not on i3 reload)
exec --no-startup-id ~/.config/eva-shell/scripts/boot-sequence.sh

# Polybar
exec_always --no-startup-id ~/.config/eva-shell/scripts/launch-polybar.sh

# eww HUD panels (all 4 windows)
exec_always --no-startup-id ~/.config/eva-shell/scripts/launch-eww.sh

# Set wallpaper (pure black)
exec_always --no-startup-id xsetroot -solid "#000000"

# MAGI TUI — top tile in workspace 1 (system dashboard)
exec --no-startup-id kitty --class eva-magi-tui --title "MAGI_SYSTEM" ~/.config/eva-shell/scripts/magi-tui.sh

# Central canvas — working terminal (bottom tile in workspace 1)
exec --no-startup-id bash -c 'sleep 1.5 && kitty --class eva-center --title "CENTRAL_TERM"'

# ============================================================
# WINDOW RULES
# ============================================================

# MAGI TUI — tiling, takes ~40% of vertical space in center
for_window [class="eva-magi-tui"] floating disable, border pixel 1
for_window [class="eva-magi-tui"] resize set height 350 px

# Central canvas — always tiling, never float
for_window [class="eva-center"] floating disable

# eww windows — let eww manage its own positioning
for_window [class="eva-left.*"]     floating enable, border none
for_window [class="eva-right.*"]    floating enable, border none
for_window [class="eva-bottom.*"]   floating enable, border none
for_window [class="eva-overlay.*"]  floating enable, border none

# ============================================================
# WORKSPACES
# ============================================================
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

# ============================================================
# HOTKEYS
# ============================================================

# Terminal
bindsym $mod+Return exec kitty --class eva-center

# App launcher
bindsym $mod+d exec rofi -show drun -theme ~/.config/rofi/config.rasi

# Close window
bindsym $mod+Shift+q kill

# Exit i3
bindsym $mod+Shift+e exec i3-nagbar \
    -t warning \
    -m 'MAGI SYSTEM: EXIT CONFIRMATION REQUIRED' \
    -B 'CONFIRM SHUTDOWN' 'i3-msg exit'

# Reload i3 config
bindsym $mod+Shift+r reload

# Restart i3 in-place
bindsym $mod+Shift+c restart

# Split direction
bindsym $mod+h split h
bindsym $mod+v split v

# Fullscreen (central canvas only)
bindsym $mod+f fullscreen toggle

# Resize mode
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym Left  resize shrink width  10 px or 10 ppt
    bindsym Down  resize grow   height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow   width  10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

# Focus movement
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# Move window
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# Layout toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Volume
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# Brightness
bindsym XF86MonBrightnessUp   exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

# Screenshot
bindsym Print exec import -window root ~/Pictures/eva-screenshot-$(date +%s).png
