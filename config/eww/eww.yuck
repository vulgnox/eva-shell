; MAGI SUPERCOMPUTER — Full HUD Panel System
; 4 windows: left-panel, magi-center, right-panel, bottom-panel
; No overlap with center workspace (i3 gaps handle separation)
; ============================================================

; ============================================================
; POLLS — data sources
; ============================================================
(defpoll magi_data   :interval "2s"  :initial "{}" `~/.config/eva-shell/scripts/magi-stats.sh`)
(defpoll mel_llm     :interval "30s" :initial "Systems nominal. No anomalies detected." `~/.config/eva-shell/scripts/melchior.sh`)
(defpoll net_data    :interval "3s"  :initial "{}" `~/.config/eva-shell/scripts/net-stats.sh`)
(defpoll log_lines   :interval "2s"  :initial "" `~/.config/eva-shell/scripts/log-poll.sh`)
(defpoll proc_data   :interval "3s"  :initial "" `~/.config/eva-shell/scripts/proc-poll.sh`)
(defpoll file_list   :interval "10s" :initial "" `~/.config/eva-shell/scripts/file-poll.sh`)
(defpoll kbd_data    :interval "1s"  :initial "" `~/.config/eva-shell/scripts/kbd-poll.sh`)
